# ── V.E.L.O.C.I.T.Y. Share - Environment Configuration ──
# Copy this file to .env and fill in your values before deploying.

# ASP.NET Core environment (Production | Development)
ASPNETCORE_ENVIRONMENT=Production

# ── Credentials (REQUIRED in Production) ──
# Admin API key: min 32 characters, used for all sensitive API endpoints.
# Generate with: openssl rand -hex 32
VELOCITY_API_KEY=

# WebSocket authentication token: min 16 characters.
# Generate with: openssl rand -hex 16
VELOCITY_WS_TOKEN=

# ── CORS ──
# Allowed origin for browser requests
CORS_ALLOWED_ORIGIN=https://share.unitbuilds.com

# ── Optional Overrides ──
# ASPNETCORE_URLS=http://+:5000
