<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VelocityShare.Mobile.MainPage"
             BackgroundColor="{StaticResource BgBase}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ═══ HEADER BAR ═══ -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource BgSidebar}" Padding="20,16,20,14"
              ColumnDefinitions="Auto, *, Auto">

            <!-- Logo circle -->
            <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                    BackgroundColor="Transparent" Stroke="{StaticResource Green}"
                    StrokeThickness="2" StrokeShape="RoundRectangle 18"
                    VerticalOptions="Center" Margin="0,0,12,0">
                <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5"
                         Color="{StaticResource Cyan}" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <!-- Brand title -->
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                <Label Text="V.E.L.O.C.I.T.Y." FontSize="16" FontAttributes="Bold"
                       TextColor="{StaticResource Green}" CharacterSpacing="2"/>
                <Label Text="Share Mobile" FontSize="11" TextColor="{StaticResource TextMuted}"
                       CharacterSpacing="1" Margin="0,-2,0,0"/>
            </VerticalStackLayout>

            <!-- Connection pill -->
            <Border Grid.Column="2" BackgroundColor="{StaticResource BgInput}"
                    Stroke="{StaticResource Border}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 16" Padding="10,5"
                    VerticalOptions="Center">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <BoxView x:Name="ConnectionDot" WidthRequest="8" HeightRequest="8"
                             CornerRadius="4" Color="{StaticResource Red}"/>
                    <Label x:Name="ConnectionLabel" Text="Offline" FontSize="11"
                           TextColor="{StaticResource TextSecondary}" FontAttributes="Bold"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- ═══ MAIN SCROLLABLE CONTENT ═══ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14" Padding="16,16,16,24">

                <!-- ── YOUR ID CARD ── -->
                <Border BackgroundColor="{StaticResource BgCard}" Stroke="{StaticResource Border}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="20">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="YOUR CONNECTION ID" FontSize="10" FontAttributes="Bold"
                               TextColor="{StaticResource TextMuted}" CharacterSpacing="2"
                               HorizontalOptions="Center"/>
                        <Label x:Name="MyPeerIdLabel" Text="---" FontSize="26" FontAttributes="Bold"
                               TextColor="{StaticResource Cyan}" HorizontalOptions="Center"
                               CharacterSpacing="1"/>
                        <Label Text="Share this ID with peers so they can send you files"
                               FontSize="11" TextColor="{StaticResource TextMuted}"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        <Button x:Name="CopyIdBtn" Text="Copy ID" Clicked="OnCopyIdClicked"
                                Style="{StaticResource OutlineButton}"
                                HorizontalOptions="Center" Margin="0,4,0,0"
                                FontSize="11" Padding="16,8" CornerRadius="8"
                                MinimumHeightRequest="36"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ── SYNC CONFIGURATION CARD ── -->
                <Border BackgroundColor="{StaticResource BgCard}" Stroke="{StaticResource Border}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="20">
                    <VerticalStackLayout Spacing="14">
                        <!-- Card header -->
                        <HorizontalStackLayout Spacing="10">
                            <Border WidthRequest="34" HeightRequest="34"
                                    BackgroundColor="#1a1500" Stroke="{StaticResource Amber}"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                <Label Text="⟳" FontSize="16" TextColor="{StaticResource Amber}"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                <Label Text="Sync Configuration" FontSize="15" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="Configure your folder sync profile" FontSize="11"
                                       TextColor="{StaticResource TextMuted}"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,4,0,0"/>

                        <!-- Server URL -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="SERVER URL" FontSize="10" FontAttributes="Bold"
                                   TextColor="{StaticResource TextMuted}" CharacterSpacing="1"/>
                            <Entry x:Name="ServerUrlEntry" Text="https://share.unitbuilds.com"
                                   Placeholder="https://your-server.com"
                                   Keyboard="Url" TextColor="{StaticResource TextPrimary}"/>
                        </VerticalStackLayout>

                        <!-- Local Path -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="LOCAL SYNC FOLDER" FontSize="10" FontAttributes="Bold"
                                   TextColor="{StaticResource TextMuted}" CharacterSpacing="1"/>
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                <Entry x:Name="LocalPathEntry" Placeholder="Select sync folder..."
                                       TextColor="{StaticResource TextPrimary}" IsReadOnly="True"/>
                                <Button Grid.Column="1" Text="Browse" Clicked="OnBrowseFolderClicked"
                                        Style="{StaticResource OutlineButton}"
                                        FontSize="11" Padding="12,6" CornerRadius="8"
                                        MinimumHeightRequest="40" VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Target Peer ID -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="TARGET PEER ID" FontSize="10" FontAttributes="Bold"
                                   TextColor="{StaticResource TextMuted}" CharacterSpacing="1"/>
                            <Entry x:Name="TargetPeerIdEntry" Placeholder="e.g. peer_ab12cd"
                                   TextColor="{StaticResource TextPrimary}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ── SYNC STATUS CARD ── -->
                <Border BackgroundColor="{StaticResource BgCard}" Stroke="{StaticResource Border}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="10">
                                <Border WidthRequest="34" HeightRequest="34"
                                        BackgroundColor="#001a0d" Stroke="{StaticResource Green}"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                    <Label Text="●" FontSize="18" TextColor="{StaticResource Green}"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                    <Label Text="Sync Status" FontSize="15" FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <Border Grid.Column="1" x:Name="StatusBadge" BackgroundColor="#1a0008"
                                    Stroke="{StaticResource Red}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 6" Padding="8,3"
                                    VerticalOptions="Center">
                                <Label x:Name="StatusBadgeLabel" Text="INACTIVE" FontSize="10"
                                       FontAttributes="Bold" TextColor="{StaticResource Red}"
                                       CharacterSpacing="1"/>
                            </Border>
                        </Grid>

                        <!-- Stats grid -->
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto"
                              RowSpacing="4" ColumnSpacing="8" Margin="0,4,0,0">
                            <Label Grid.Row="0" Grid.Column="0" Text="Files Synced"
                                   FontSize="10" TextColor="{StaticResource TextMuted}"
                                   HorizontalTextAlignment="Center" CharacterSpacing="0.5"/>
                            <Label Grid.Row="0" Grid.Column="1" Text="Data Sent"
                                   FontSize="10" TextColor="{StaticResource TextMuted}"
                                   HorizontalTextAlignment="Center" CharacterSpacing="0.5"/>
                            <Label Grid.Row="0" Grid.Column="2" Text="Uptime"
                                   FontSize="10" TextColor="{StaticResource TextMuted}"
                                   HorizontalTextAlignment="Center" CharacterSpacing="0.5"/>
                            <Label Grid.Row="1" Grid.Column="0" x:Name="FilesSyncedLabel"
                                   Text="0" FontSize="18" FontAttributes="Bold"
                                   TextColor="{StaticResource Green}" HorizontalTextAlignment="Center"/>
                            <Label Grid.Row="1" Grid.Column="1" x:Name="DataSentLabel"
                                   Text="0 KB" FontSize="18" FontAttributes="Bold"
                                   TextColor="{StaticResource Cyan}" HorizontalTextAlignment="Center"/>
                            <Label Grid.Row="1" Grid.Column="2" x:Name="UptimeLabel"
                                   Text="--:--" FontSize="18" FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ── ACTIVITY LOG CARD ── -->
                <Border BackgroundColor="#05070a" Stroke="{StaticResource Border}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Activity Log" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                            <Label x:Name="LogCountLabel" Text="0 events" FontSize="10"
                                   TextColor="{StaticResource TextMuted}" VerticalOptions="Center"
                                   Margin="4,0,0,0"/>
                        </HorizontalStackLayout>
                        <ScrollView x:Name="LogScroll" HeightRequest="140">
                            <Label x:Name="LogLabel"
                                   Text="[System] Awaiting sync initialization...&#10;"
                                   TextColor="{StaticResource Green}" FontSize="11"
                                   FontFamily="OpenSansRegular" LineHeight="1.4"/>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <!-- ── ACTION BUTTON ── -->
                <Button x:Name="ToggleSyncBtn"
                        Text="START FOLDER SYNC"
                        Clicked="OnToggleSyncClicked"
                        FontSize="15" FontAttributes="Bold"
                        BackgroundColor="{StaticResource Green}"
                        TextColor="{StaticResource BgBase}"
                        CornerRadius="12" HeightRequest="56"
                        Margin="0,4,0,0"
                        CharacterSpacing="1"/>

                <!-- ── FOOTER ── -->
                <Label Text="V.E.L.O.C.I.T.Y. Suite  ·  Secure Zero-Knowledge Sync"
                       FontSize="10" TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       Margin="0,8,0,0" CharacterSpacing="0.5"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
