<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VelocityShare.Tests" />
  </ItemGroup>

  <!-- Windows: use committed pre-built DLL -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Update="velocity_share_ffi.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Velocity.NDA">
      <HintPath>Velocity.NDA.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <!-- Windows: copy from local Rust build if available -->
  <Target Name="CopyRustDll" BeforeTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Copy SourceFiles="..\velocity_share_ffi\target\release\velocity_share_ffi.dll"
          DestinationFolder="."
          SkipUnchangedFiles="true"
          Condition="Exists('..\velocity_share_ffi\target\release\velocity_share_ffi.dll')" />
  </Target>

  <!-- Linux: copy shared object from Cargo build to output -->
  <Target Name="CopyRustSo" AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Copy SourceFiles="..\velocity_share_ffi\target\release\libvelocity_share_ffi.so"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
