{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "https://share.unitbuilds.com" ],
    "AllowedMethods": [ "GET", "POST" ],
    "AllowedHeaders": [ "Content-Type", "Authorization", "X-API-Key", "X-WS-Token" ]
  },
  "RateLimiting": {
    "MaxRequestsPerMinute": 100,
    "WindowSizeSeconds": 60
  },
  "Security": {
    "MaxConcurrentPeers": 128,
    "MaxPeerIdLength": 64,
    "MaxUploadSizeMB": 50,
    "MaxPathLength": 500,
    "RequestTimeoutSeconds": 60,
    "AllowedDropsiteTypes": [ "local_nas", "google_drive_mock", "onedrive_mock" ]
  },
  "Credentials": {
    "AdminApiKey": "",
    "WebSocketToken": "",
    "RequireAuthInDevelopment": false
  }
}
